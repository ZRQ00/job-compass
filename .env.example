# Copy to .env and adjust. All values are optional.

# Where your Ollama server is. Inside Docker, host.docker.internal means "this machine".
# Use your Tailscale / LAN IP if Ollama runs on another box, e.g. http://100.x.y.z:11434
OLLAMA_URL=http://host.docker.internal:11434
REASONING_MODEL=gemma4:26b

WEEKLY_GOAL=10
FOLLOW_UP_AFTER_DAYS=7

# Where the browser reaches the API
VITE_API_URL=http://localhost:9500
